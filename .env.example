# =============================================================================
# Consent Management Backend - Environment Variables
# Copy to .env and set values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Master: auth + tenant registry. Required for app to run.
# If password has special chars (@ : / # % etc.), URL-encode them (e.g. @ → %40, : → %3A).
MASTER_DATABASE_URL="postgresql://user:password@localhost:5432/consent_master"

# Tenant: used only for `prisma migrate` / `prisma generate`. Each tenant has its own DB URL in Tenant.databaseUrl.
TENANT_DATABASE_URL="postgresql://user:password@localhost:5432/tenant_default"

# -----------------------------------------------------------------------------
# JWT (required in production; use strong random secrets)
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-access-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Bcrypt rounds for password hashing (10–12 typical)
BCRYPT_ROUNDS=10

# Rate limit: window in ms, max requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Allowed origin(s). Use * for any, or comma-separated list (e.g. http://localhost:5173,https://app.example.com)
CORS_ORIGIN=http://localhost:5173
# Send credentials (cookies/auth headers)
CORS_CREDENTIALS=true
