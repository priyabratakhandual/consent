// Tenant database schema. Same structure in every tenant's isolated DB.
// URL is overridden at runtime via getTenantClient(tenantId) / Tenant.database_url.
generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/tenant"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. Consent – tenant-scoped (form + record); share links generated per consent
// ---------------------------------------------------------------------------

model Consent {
  id             String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  templateId     String?   @map("template_id")
  name           String
  description    String?
  type           String
  granted        Boolean   @default(true)
  metadata       Json?
  lifecycleState String    @default("DRAFT") @map("lifecycle_state")
  expiryDate     DateTime? @map("expiry_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  audits      ConsentAudit[]
  acceptances ConsentAcceptance[]
  revocations ConsentRevocation[]
  shareLinks  ConsentShareLink[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 2. Consent Audit
// ---------------------------------------------------------------------------

model ConsentAudit {
  id             String    @id @default(uuid())
  consentId      String    @map("consent_id")
  templateId     String    @map("template_id")
  versionNumber  Int       @map("version_number")
  metadata       Json?     @map("metadata")
  createdAt      DateTime  @default(now()) @map("created_at")
  lifecycleState String    @default("DRAFT") @map("lifecycle_state")
  expiryDate     DateTime? @map("expiry_date")

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@map("consent_audits")
}

// ---------------------------------------------------------------------------
// ConsentSigner (consent_signers) – person who accepted; for login, revocation, email
// ---------------------------------------------------------------------------
model ConsentSigner {
  id           String   @id @default(uuid())
  email        String?  @map("email")
  phone        String?  @map("phone")
  name         String   @map("name")
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  acceptances  ConsentAcceptance[]
  revocations  ConsentRevocation[]  @relation("RevokedBySigner")

  @@index([email])
  @@index([phone])
  @@map("consent_signers")
}

// ---------------------------------------------------------------------------
// 6. Consent Acceptance (when consent is accepted via link or otherwise)
// ---------------------------------------------------------------------------

model ConsentAcceptance {
  id            String    @id @default(uuid())
  consentId     String    @map("consent_id")
  consentSignerId String?  @map("consent_signer_id")
  shareLinkId   String?   @map("share_link_id")
  acceptedAt   DateTime  @default(now()) @map("accepted_at")
  ipAddress    String?   @map("ip_address")
  deviceInfo   String?   @map("device_info")
  signatureData String?  @map("signature_data")
  otpVerified  Boolean   @default(false) @map("otp_verified")
  receiptUrl   String?   @map("receipt_url")
  status       String    @default("ACTIVE") @map("status") // ACTIVE | REVOKED
  revokedAt    DateTime? @map("revoked_at")

  consent    Consent            @relation(fields: [consentId], references: [id], onDelete: Cascade)
  consentSigner ConsentSigner?  @relation(fields: [consentSignerId], references: [id], onDelete: SetNull)
  shareLink  ConsentShareLink?   @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  revocations ConsentRevocation[]

  @@index([consentId])
  @@index([consentSignerId])
  @@index([shareLinkId])
  @@index([status])
  @@map("consent_acceptances")
}

// ---------------------------------------------------------------------------
// 7. Consent Revocation – user-initiated or application-triggered
// ---------------------------------------------------------------------------

model ConsentRevocation {
  id                 String   @id @default(uuid())
  consentId          String   @map("consent_id")
  acceptanceId       String?  @map("acceptance_id")
  revokedByType      String   @map("revoked_by_type") // USER | APPLICATION
  consentSignerId    String?  @map("consent_signer_id") // for USER
  revokedBy          String?  @map("revoked_by") // for APPLICATION: userId
  reason             String?
  revokedAt         DateTime @default(now()) @map("revoked_at")
  createdAt         DateTime @default(now()) @map("created_at")

  consent    Consent            @relation(fields: [consentId], references: [id], onDelete: Cascade)
  acceptance ConsentAcceptance? @relation(fields: [acceptanceId], references: [id], onDelete: SetNull)
  consentSigner ConsentSigner?  @relation("RevokedBySigner", fields: [consentSignerId], references: [id], onDelete: SetNull)

  @@index([consentId])
  @@index([acceptanceId])
  @@map("consent_revocations")
}

// ---------------------------------------------------------------------------
// 5. Consent Share Links (per consent: public or private with API keys)
// ---------------------------------------------------------------------------

model ConsentShareLink {
  id         String    @id @default(uuid())
  consentId  String    @map("consent_id")
  token      String    @unique
  nickname   String?   @map("nickname") // optional label for the link (e.g. "Campaign A")
  visibility String    @default("PUBLIC") @map("visibility") // PUBLIC, PRIVATE
  status     String    @default("ACTIVE") @map("status") // ACTIVE, REVOKED, EXPIRED
  expiresAt  DateTime? @map("expires_at")
  usageLimit Int?      @map("usage_limit") // max number of acceptances via this link; null = unlimited
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  consent     Consent              @relation(fields: [consentId], references: [id], onDelete: Cascade)
  apiKeys     ConsentShareApiKey[]
  acceptances ConsentAcceptance[]

  @@index([consentId])
  @@index([token])
  @@map("consent_share_links")
}

model ConsentShareApiKey {
  id         String    @id @default(uuid())
  linkId     String    @map("link_id")
  name       String    @map("name")
  valueHash  String    @map("value_hash")
  status     String    @default("ACTIVE") @map("status") // ACTIVE, REVOKED, EXPIRED
  usageLimit Int?      @map("usage_limit") // max API calls; null = unlimited
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  link ConsentShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("consent_share_api_keys")
}
