// Tenant database schema. Same structure in every tenant's isolated DB.
// URL is overridden at runtime via getTenantClient(tenantId) / Tenant.database_url.
generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/tenant"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// Consent records (consent forms) for this tenant only. user_id = master User id.
model Consent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  granted     Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("consents")
}

// Optional: applications / other tenant-scoped models (user_id = master User id).
model Application {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("applications")
}
