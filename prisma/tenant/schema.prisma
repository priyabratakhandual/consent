// Tenant database schema. Same structure in every tenant's isolated DB.
// URL is overridden at runtime via getTenantClient(tenantId) / Tenant.database_url.
generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/tenant"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. Consent – tenant-scoped (form + record); share links generated per consent
// ---------------------------------------------------------------------------

model Consent {
  id             String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  templateId     String?   @map("template_id")
  name           String
  description    String?
  type           String
  granted        Boolean   @default(true)
  metadata       Json?
  lifecycleState String    @default("DRAFT") @map("lifecycle_state")
  expiryDate     DateTime? @map("expiry_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  audits      ConsentAudit[]
  acceptances ConsentAcceptance[]
  revocations ConsentRevocation[]
  shareLinks  ConsentShareLink[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 2. Consent Audit
// ---------------------------------------------------------------------------

model ConsentAudit {
  id             String    @id @default(uuid())
  consentId      String    @map("consent_id")
  templateId     String    @map("template_id")
  versionNumber  Int       @map("version_number")
  metadata       Json?     @map("metadata")
  createdAt      DateTime  @default(now()) @map("created_at")
  lifecycleState String    @default("DRAFT") @map("lifecycle_state")
  expiryDate     DateTime? @map("expiry_date")

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@map("consent_audits")
}

// ---------------------------------------------------------------------------
// 6. Consent Acceptance (when consent is accepted via link or otherwise)
// ---------------------------------------------------------------------------

model ConsentAcceptance {
  id            String   @id @default(uuid())
  consentId     String   @map("consent_id")
  shareLinkId   String?  @map("share_link_id") // set when accepted via a share link
  acceptedAt    DateTime @default(now()) @map("accepted_at")
  ipAddress     String?  @map("ip_address")
  deviceInfo    String?  @map("device_info")
  signatureData String?  @map("signature_data")
  otpVerified   Boolean  @default(false) @map("otp_verified")
  receiptUrl    String?  @map("receipt_url")

  consent   Consent           @relation(fields: [consentId], references: [id], onDelete: Cascade)
  shareLink ConsentShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([consentId])
  @@index([shareLinkId])
  @@map("consent_acceptances")
}

// ---------------------------------------------------------------------------
// 7. Consent Revocation
// ---------------------------------------------------------------------------

model ConsentRevocation {
  id        String   @id @default(uuid())
  consentId String   @map("consent_id")
  revokedAt DateTime @default(now()) @map("revoked_at")
  revokedBy String?  @map("revoked_by")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId])
  @@map("consent_revocations")
}

// ---------------------------------------------------------------------------
// 5. Consent Share Links (per consent: public or private with API keys)
// ---------------------------------------------------------------------------

model ConsentShareLink {
  id         String    @id @default(uuid())
  consentId  String    @map("consent_id")
  token      String    @unique
  visibility String    @default("PUBLIC") @map("visibility") // PUBLIC, PRIVATE
  status     String    @default("ACTIVE") @map("status") // ACTIVE, REVOKED, EXPIRED
  expiresAt  DateTime? @map("expires_at")
  usageLimit Int?      @map("usage_limit") // max number of acceptances via this link; null = unlimited
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  consent     Consent              @relation(fields: [consentId], references: [id], onDelete: Cascade)
  apiKeys     ConsentShareApiKey[]
  acceptances ConsentAcceptance[]

  @@index([consentId])
  @@index([token])
  @@map("consent_share_links")
}

model ConsentShareApiKey {
  id         String    @id @default(uuid())
  linkId     String    @map("link_id")
  name       String    @map("name")
  valueHash  String    @map("value_hash")
  status     String    @default("ACTIVE") @map("status") // ACTIVE, REVOKED, EXPIRED
  usageLimit Int?      @map("usage_limit") // max API calls; null = unlimited
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  link ConsentShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("consent_share_api_keys")
}
