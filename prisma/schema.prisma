// Master database: auth + tenant registry. All login/signup use this DB.
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/master"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  userTenants UserTenant[]

  @@map("users")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique // e.g. "acme-corp" for DB name tenant_acme_corp
  databaseUrl  String       @map("database_url") // Full PostgreSQL URL to this tenant's isolated DB
  status       String       @default("active") // active | suspended
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  userTenants  UserTenant[]

  @@map("tenants")
}

model UserTenant {
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@map("user_tenants")
}
