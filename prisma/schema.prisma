// Master database: identity (business users) + tenant registry.
// One DB for all users; each Tenant has its own isolated DB (database_url).
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/master"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

// Business user (signs up, logs in). Each gets one tenant (isolated DB) auto-created on signup.
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  userTenants UserTenant[]

  @@map("users")
}

// One row per tenant (business). database_url = connection to that tenant's isolated PostgreSQL DB.
model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  databaseUrl  String       @map("database_url")
  status       String       @default("active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  userTenants  UserTenant[]

  @@map("tenants")
}

model UserTenant {
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@map("user_tenants")
}
