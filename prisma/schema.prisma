// Master database: tenants, tenant config, identity (users) + user-tenant membership.
// One DB for all; each Tenant can have its own isolated DB (database_url) for tenant data.
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/master"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 3. Tenant & Security Tables
// ---------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  slug        String   @unique // for routing / display
  databaseUrl String?  @map("database_url") // optional; if set, tenant has isolated DB
  // Per-tenant configuration (inlined from TenantConfiguration)
  defaultConsentValidityDays Int?    @map("default_consent_validity_days")
  retentionPolicyDays        Int?    @map("retention_policy_days")
  webhookUrl                 String? @map("webhook_url")
  webhookSecret              String? @map("webhook_secret")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("tenants")
}

// Users (admin/operators). One row per user per tenant; UNIQUE(tenant_id, email).
model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String // SUPER_ADMIN, TENANT_ADMIN, OPERATOR, AUDITOR
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

// predefined templates for a consent form
model Template {
  id          String @id @default(uuid())
  title       String @map("title")
  description String @map("description")
  content     Json   @map("content")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("templates")
}
